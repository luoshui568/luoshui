":{"bottom":0},"grid":{"left":56,"right":50,"top":30,"bottom":44},"xAxis":{"type":"category","data":["2024H2","2025H1","2025H2","2026H1"]},"yAxis":[{"type":"value","name":"PE"},{"type":"value","name":"PB"}],"series":[{"name":"PE(TTM)","type":"line","data":[20,18,17,15.9],"itemStyle":{"color":"#c0392b"},"smooth":true},{"name":"PB","type":"line","yAxisIndex":1,"data":[1.9,1.8,1.7,1.55],"itemStyle":{"color":"#c8102e"},"smooth":true}]}},{"id":"chartPrice2","seq":9,"name":"股价解读","opt":{"tooltip":{"trigger":"axis"},"legend":{"bottom":0},"grid":{"left":56,"right":40,"top":30,"bottom":44},"xAxis":{"type":"category","data":["2025H1","2025H2","2026Q1","2026H1"]},"yAxis":{"type":"value","name":"元"},"series":[{"name":"股价(元)","type":"line","data":[13.5,14.2,13.8,14.92],"itemStyle":{"color":"#c8102e"},"smooth":true,"areaStyle":{"opacity":0.08}}]}}]}