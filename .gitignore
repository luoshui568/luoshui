# ── 项目内部记忆与本地缓存（含数据库结构、认证实现等细节，不入库）──
.workbuddy/

# ── 过程产物：验证截图（约 20 MB，用 mkshot_*.py 可随时重拍）──
build/*.png

# ── 历史备份 / 归档 HTML（内容已被模板取代）──
build/backup_*.html
build/archive_*.html

# ── 推库前快照目录（每次推研报都生成一份线上/本地副本，约 5 MB 且会持续增长）──
#    这些是**过程产物**不是源码：需要回滚时随时能重新导出，别入库把仓库撑肥。
#    注意写的是 backup/ 而不是 backup，`build/backup/` 才匹配目录。
build/backup/

# ── 系统垃圾 ──
Thumbs.db
desktop.ini
.DS_Store
*~

# ── Python 字节码 ──
__pycache__/
*.pyc

# ── 本地私有配置：管理员口令（探针用 `from _secret import PW` 读它，或设 WB_PW）──
build/_secret.py

# ── 本地一次性脚本 / 运行日志 / headless 浏览器临时 profile ──
#    下划线前缀 = 只在开发机用，不入库（诊断脚本、标定脚本、清理脚本、_out_*.txt …）
build/_*
build/*.log
build/src/

# ── 探针在 deploy/ 里就地清空的临时页（0 字节空壳，避免误提交成网页）──
deploy/_*.html

# ── 环境级迁移 ──
#    这个 env 里混着另一个项目（love_*）的 schema；且 20260913200000_create_admin_auth.sql
#    内含**明文种子口令** ⇒ 整个目录排除，只用 ! 白名单放行本项目自己的迁移。
#    （另一个项目的迁移可由 `tcb db pg migration fetch -e <envId>` 重新拉取。）
cloudbase/migrations/*.sql
!cloudbase/migrations/20260910070221_create_strategy_workbench.sql
!cloudbase/migrations/20260910150000_create_wb_works.sql
!cloudbase/migrations/20260912133000_fix_sort_and_timestamps.sql
!cloudbase/migrations/20260912140000_create_wb_works.sql
!cloudbase/migrations/20260913201000_admin_delete_via_rpc.sql
!cloudbase/migrations/20260913202000_admin_verify_fn.sql
!cloudbase/migrations/20260913210000_create_wb_stocks.sql
!cloudbase/migrations/20260913220000_add_stock_lock_fields.sql
!cloudbase/migrations/20260913230000_create_wb_reports.sql
!cloudbase/migrations/20260914120000_admin_register.sql
