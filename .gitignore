deploy/_*.html

# ── 环境级迁移 ──
#    这个 env 里混着另一个项目（love_*）的 schema；且 20260913200000_create_admin_auth.sql
#    内含**明文种子口令** ⇒ 整个目录排除，只用 ! 白名单放行本项目自己的迁移。
#    （另一个项目的迁移可由 `tcb db pg migration fetch -e <envId>` 重新拉取。）
cloudbase/migrations/*.sql
!cloudbase/migrations/20260910070221_create_strategy_workbench.sql
!cloudbase/migrations/20260910150000_create_wb_works.sql
!cloudbase/migrations/20260912133000_fix_sort_and_timestamps.sql
